---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideCard from '../components/GuideCard.astro';
const recipes = await getCollection('recipes');
const knowledge = await getCollection('knowledge');
const categories = ['밥', '고기', '채소', '해산물', '면', '간식', '조리법', '식재료', '보관법', '주방도구'];
const websiteSchema = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'emfls food', url: 'https://food.emfls.com/', description: '요리법뿐 아니라 식재료, 보관, 조리원리까지 다루는 실용 음식 가이드.' };
---
<BaseLayout title="emfls food — 요리의 방법과 이유를 함께" description="요리법뿐 아니라 식재료, 보관, 조리원리까지 다루는 실용 음식 가이드." jsonLd={websiteSchema}>
  <section class="hero"><div><p class="eyebrow">Modern editorial recipe book</p><h1>잘 만드는 법과<br />그 이유를 함께.</h1><p>emfls food는 오늘의 요리에서 바로 써먹을 수 있는 방법과, 맛이 달라지는 원리를 함께 정리합니다.</p><a class="button" href="/categories/">가이드 둘러보기</a></div></section>
  <section class="section"><div class="section-heading"><div><p class="eyebrow">Explore</p><h2>무엇을 찾고 있나요?</h2></div></div><div class="category-list">{categories.map((category) => <a href={`/categories/#${category}`}>{category}</a>)}</div></section>
  <section class="section tinted"><div class="section-inner"><div class="section-heading"><div><p class="eyebrow">Featured guides</p><h2>오늘의 기본기</h2></div><a class="text-link" href="/categories/">모두 보기 →</a></div><div class="guide-grid">{recipes.map((entry) => <GuideCard href={`/recipes/${entry.id.replace(/\.md$/, '')}/`} category={entry.data.category} title={entry.data.title} description={entry.data.description} label="레시피 보기 →" image={entry.data.image} />)}{knowledge.map((entry) => <GuideCard href={`/knowledge/${entry.id.replace(/\.md$/, '')}/`} category={entry.data.category} title={entry.data.title} description={entry.data.description} label="원리 읽기 →" image={entry.data.image} />)}</div></div></section>
  <section class="section"><div class="split"><div><p class="eyebrow">Cooking knowledge</p><h2>레시피 너머의<br />작은 원리들</h2></div><p class="note">왜 이 순서로 조리할까요? 남은 재료는 어떻게 보관할까요? 재료를 바꿔도 괜찮을까요? 한 끼를 만들며 생기는 질문에 답합니다.</p></div></section>
  <section class="section tinted"><div class="section-inner"><div class="section-heading"><div><p class="eyebrow">Coming into the kitchen</p><h2>주방 도구와 단위</h2></div></div><p class="note">요리 단위를 이해하기 쉽게 정리합니다. <a class="text-link" href="/tools/cooking-converter/">Cooking Converter 사용하기 →</a></p></div></section>
</BaseLayout>

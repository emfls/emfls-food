---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COOKING_UNITS } from '../../lib/cookingConverter';
const volumeUnits = Object.entries(COOKING_UNITS).filter(([, unit]) => unit.category === 'volume');
const massUnits = Object.entries(COOKING_UNITS).filter(([, unit]) => unit.category === 'mass');
---
<BaseLayout title="Cooking Converter | emfls food" description="ml, L, 작은술, 큰술, 컵, g, kg를 요리에 맞게 변환하는 간단한 조리 단위 변환기.">
  <div class="tool-shell">
    <div class="tool-intro"><p class="eyebrow">Kitchen tool</p><h1>Cooking<br />Converter</h1><p>레시피에서 자주 만나는 조리 단위를 빠르게 바꿔 보세요.</p></div>
    <section class="converter-card" aria-labelledby="converter-title">
      <h2 id="converter-title">단위 변환</h2>
      <div class="converter-fields">
        <label for="converter-value">값<input id="converter-value" type="number" inputmode="decimal" min="0" max="100000" step="any" value="1" /></label>
        <label for="converter-from">현재 단위<select id="converter-from"><optgroup label="부피">{volumeUnits.map(([key, unit]) => <option value={key} selected={key === 'tbsp'}>{unit.label}</option>)}</optgroup><optgroup label="질량">{massUnits.map(([key, unit]) => <option value={key}>{unit.label}</option>)}</optgroup></select></label>
        <button class="swap-button" type="button" id="converter-swap" aria-label="변환 단위 서로 바꾸기">↔</button>
        <label for="converter-to">변환할 단위<select id="converter-to"><optgroup label="부피">{volumeUnits.map(([key, unit]) => <option value={key} selected={key === 'ml'}>{unit.label}</option>)}</optgroup><optgroup label="질량">{massUnits.map(([key, unit]) => <option value={key}>{unit.label}</option>)}</optgroup></select></label>
      </div>
      <div class="converter-result" aria-live="polite"><span class="eyebrow">결과</span><output id="converter-output" for="converter-value converter-from converter-to">15 ml</output><p id="converter-message">1 큰술은 15 ml입니다.</p></div>
    </section>
    <section class="tool-notes"><h2>이 도구의 기준</h2><p>부피는 1컵=200ml, 1큰술=15ml, 1작은술=5ml 기준입니다. 질량은 1kg=1000g으로 계산합니다.</p><p>g과 ml은 재료마다 밀도가 달라 재료 정보 없이 직접 바꿀 수 없습니다. 밀가루, 설탕, 물의 같은 부피가 같은 무게는 아니기 때문입니다.</p></section>
  </div>
</BaseLayout>
<script>
  import { convertCookingUnit, formatConvertedValue } from '../../lib/cookingConverter';
  const valueInput = document.querySelector<HTMLInputElement>('#converter-value');
  const fromSelect = document.querySelector<HTMLSelectElement>('#converter-from');
  const toSelect = document.querySelector<HTMLSelectElement>('#converter-to');
  const output = document.querySelector<HTMLOutputElement>('#converter-output');
  const message = document.querySelector<HTMLElement>('#converter-message');
  const update = () => {
    if (!valueInput || !fromSelect || !toSelect || !output || !message) return;
    const raw = valueInput.value.trim();
    const result = convertCookingUnit(Number(raw), fromSelect.value as Parameters<typeof convertCookingUnit>[1], toSelect.value as Parameters<typeof convertCookingUnit>[2]);
    if (!raw || !Number.isFinite(Number(raw))) { output.textContent = '—'; message.textContent = '변환할 값을 입력해 주세요.'; return; }
    if (!result.ok) { output.textContent = '—'; message.textContent = result.message; return; }
    output.textContent = `${formatConvertedValue(result.value)} ${toSelect.options[toSelect.selectedIndex].text.split(' ')[0]}`;
    message.textContent = `${raw} ${fromSelect.options[fromSelect.selectedIndex].text}은(는) ${output.textContent}입니다.`;
  };
  [valueInput, fromSelect, toSelect].forEach((element) => element?.addEventListener('input', update));
  document.querySelector('#converter-swap')?.addEventListener('click', () => { if (!fromSelect || !toSelect) return; const current = fromSelect.value; fromSelect.value = toSelect.value; toSelect.value = current; update(); });
  update();
</script>

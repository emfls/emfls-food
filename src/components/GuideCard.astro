---
interface Props { href: string; category: string; title: string; description: string; label?: string; image?: { src: string; alt: string }; }
const { href, category, title, description, label = '읽어보기', image } = Astro.props;
import ContentImage from './ContentImage.astro';
---
<article class="guide-card">{image && <a href={href} aria-label={`${title} 이미지`}><ContentImage image={image} variant="card" /></a>}<p class="eyebrow">{category}</p><h3><a href={href}>{title}</a></h3><p>{description}</p><a class="text-link" href={href}>{label} <span aria-hidden="true">→</span></a></article>
